PORT=4100
NODE_ENV=development

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Shared secret for the price-scraper GitHub Action to POST rates to
# /api/prices/snapshots. Generate a long random value; must match the
# PRICE_INGEST_KEY GitHub Actions secret. If unset, ingest is rejected (503).
PRICE_INGEST_KEY=

# --- Messaging (optional; leave blank until you have keys) -------------
# Until these are set, "Send" logs each message as not_configured and
# nothing is sent. See docs/MESSAGING_SETUP.md.
# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_AUCTION_NOTICE=loan_auction_notice
# Twilio SMS (India needs a DLT-registered sender + template)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Release OTP (Twilio SMS above) ------------------------------------
# HMAC key for OTP codes; any long random string (falls back to the
# service-role key if unset). Until Twilio is configured, OTPs are logged as
# not_configured and - outside production only - the code is shown on screen.
OTP_SECRET=

# --- Nightly email summary ----------------------------------------------
# Any SMTP provider: Gmail (app password, smtp.gmail.com:587), Zoho,
# Brevo, SES... Until SMTP_HOST is set the summary is built but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Haripriya Jewels <reports@example.com>"
# Recipients if none are saved in Settings -> Nightly email summary.
DIGEST_TO=
# Shared secret the daily-digest GitHub Action sends as X-Cron-Key; must
# match the CRON_SECRET Actions secret. If unset, /api/digest/run is rejected.
CRON_SECRET=
# Frontend URL, for "Open loan" links in the email.
APP_URL=https://your-app.vercel.app

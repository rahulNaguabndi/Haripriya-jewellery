PORT=4100
NODE_ENV=development

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Shared secret for the price-scraper GitHub Action to POST rates to
# /api/prices/snapshots. Generate a long random value; must match the
# PRICE_INGEST_KEY GitHub Actions secret. If unset, ingest is rejected (503).
PRICE_INGEST_KEY=
